#jinja2: trim_blocks: True, lstrip_blocks: False

{% for name, entries in item.value.items() %}
Section "{{ name }}"
  {% for entry in entries %}
    {% if entry is mapping %}
      {% for subname, subentries in entry.items() %}
	SubSection "{{ subname }}"
          {% for subentry in subentries %}
		{{ subentry }}
          {% endfor %}
	EndSubSection
      {% endfor -%}
    {% else %}
	{{ entry }}
    {% endif %}
  {% endfor %}
EndSection
{% endfor %}
